{
  "name": "v4",
  "description": "Personal Website V4",
  "version": "1.0.0",
  "author": "Charles Lim <milselarch@protonmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/bchiang7/v4"
  },
  "keywords": [
    "nextjs"
  ],
  "license": "MIT",
  "browserslist": [
    "> 0.25%, not dead"
  ],
  "scripts": {
    "dev": "next dev -p 6006",
    "build": "next build",
    "start": "python3 -m http.server 6006 --directory out",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "deploy-gh": "next build && gh-pages -d out -b main",
    "deploy-firebase": "next build && firebase deploy",
    "clean": "rm -rf .next out",
    "prepare": "husky install",
    "lint-staged": "lint-staged",
    "sync-content": "rm -rf public/content && mkdir -p public && cp -R content public/content",
    "predev": "npm run sync-content",
    "prebuild": "npm run sync-content"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,css,json,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@types/node": "^24.3.0",
    "animejs": "^3.1.0",
    "gray-matter": "^4.0.3",
    "lodash": "^4.17.21",
    "next": "^14.2.5",
    "prismjs": "1.30.0",
    "prop-types": "^15.8.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-transition-group": "^4.4.5",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-html": "^16.0.1",
    "scrollreveal": "^4.0.9",
    "styled-components": "^6.1.8"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.28.0",
    "@typescript-eslint/parser": "^8.28.0",
    "@upstatement/eslint-config": "^3.0.0",
    "@upstatement/prettier-config": "^1.0.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.0.0",
    "eslint-config-standard": "^17.1.0",
    "eslint-import-resolver-alias": "^1.1.2",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.4.1",
    "eslint-plugin-n": "^16.0.0",
    "eslint-plugin-promise": "^6.0.0",
    "eslint-plugin-react": "^7.37.4",
    "gh-pages": "^6.3.0",
    "husky": "^6.0.0",
    "lint-staged": "^10.1.2",
    "prettier": "^3.0.1",
    "sass": "^1.83.4",
    "typescript": "^5.8.2",
    "@babel/eslint-parser": "^7.13.14",
    "@babel/preset-react": "^7.13.13",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1"
  }
}
